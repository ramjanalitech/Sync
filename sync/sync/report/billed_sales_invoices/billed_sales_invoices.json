 "query": "SELECT\n    si.name AS \"Invoice:Link/Sales Invoice:150\",\n    si.customer AS \"Customer:Link/Customer:150\",\n    si.posting_date AS \"Posting Date:Date:100\",\n    si.total AS \"Total:Currency:120\",\n    si.grand_total AS \"Grand Total:Currency:120\",\n    si.status AS \"Status:Data:100\",\n    si.margin_per AS \"Margin Per:Float:100\",\n    si.margin_amount AS \"Margin Amount:Currency:120\"\nFROM\n    `tabSales Invoice` si\nWHERE\n    si.is_bill = 1\nORDER BY\n    si.posting_date DESC\n",
